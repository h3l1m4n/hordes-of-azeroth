						<Anchor point="TOP" relativeTo="$parentClass" relativePoint="BOTTOM">
							<Offset>
								<AbsDimension x="0" y="-2"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				BonkHero_SelectClass(this:GetID());
			</OnClick>
		</Scripts>
		<HighlightTexture alphaMode="ADD" file="Interface\Buttons\ButtonHilight-Square">
			<Size>
				<AbsDimension x="52" y="52"/>
			</Size>
			<Anchors>
				<Anchor point="TOP">
					<Offset>
						<AbsDimension x="0" y="-6"/>
					</Offset>
				</Anchor>
