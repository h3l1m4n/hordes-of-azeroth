						<Anchor point="TOP" relativeTo="$parentIcon" relativePoint="BOTTOM">
							<Offset>
								<AbsDimension x="0" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentHero" inherits="GlueFontHighlightSmall">
