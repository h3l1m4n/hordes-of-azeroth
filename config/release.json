{
  "repository": "jonhaldors/hordes-of-azeroth",
  "productName": "Hordes of Azeroth",
  "minLauncherVersion": "0.1.0",
  "realmName": "Hordes of Azeroth",
  "clientDlls": ["ClassicAPI.dll", "HordesOfAzerothClientFix.dll"],
  "thirdParty": [
    {
      "name": "MariaDB",
      "version": "11.4.13",
      "licence": "GPL-2.0",
      "url": "https://archive.mariadb.org/mariadb-11.4.13/winx64-packages/mariadb-11.4.13-winx64.zip",
      "localCopy": "server/downloads/mariadb-11.4.13-winx64.zip",
      "install": { "unzipTo": "server/mariadb", "stripTopFolder": true }
    },
    {
      "name": "VanillaFixes",
      "version": "1.5.3",
      "licence": "MIT",
      "url": "https://github.com/hannesmann/vanillafixes/releases/download/v1.5.3/vanillafixes-1.5.3-dxvk.zip",
      "install": { "unzipTo": ".", "stripTopFolder": false }
    },
    {
      "name": "ClassicAPI",
      "version": "1.15.16",
      "licence": "GPL-3.0",
      "url": "https://github.com/brues-code/ClassicAPI/releases/download/v1.15.16/ClassicAPI.dll",
      "install": { "copyTo": "ClassicAPI.dll" }
    }
  ],
  "packages": [
    { "name": "launcher", "build": "launcher", "changesWith": "tools/launcher/*.*", "files": [{ "from": "release/build/launcher/HoALauncher.exe", "to": "HoALauncher.exe" }] },
    { "name": "addon", "git": ["Interface/AddOns/HordesOfAzeroth"] },
    { "name": "glue", "git": ["Interface/GlueXML"] },
    { "name": "client-fix", "files": [{ "from": "HordesOfAzerothClientFix.dll" }] },
    { "name": "client-runtime", "build": "client-runtime", "files": [{ "from": "release/build/client-runtime/vcruntime140.dll", "to": "vcruntime140.dll" }] },
    {
      "name": "wow-turbo",
      "files": [
        { "from": "mods/wow_turbo/avx/wow_turbo.dll" },
        { "from": "mods/wow_turbo/sse/wow_turbo.dll" },
        { "from": "mods/wow_turbo/LICENSE" }
      ]
    },
    { "name": "telegraphkit", "build": "telegraphkit", "changesWith": "tools/telegraphs/*.cs", "files": [{ "from": "release/build/TelegraphKit.exe", "to": "tools/TelegraphKit.exe" }] },
    {
      "name": "server",
      "build": "server",
      "files": [
        { "from": "release/build/server-install/mangosd.exe", "to": "server/run/mangosd.exe" },
        { "from": "release/build/server-install/realmd.exe", "to": "server/run/realmd.exe" },
        { "from": "release/build/server-install/libeay32.dll", "to": "server/run/libeay32.dll" },
        { "from": "release/build/server-install/libmySQL.dll", "to": "server/run/libmySQL.dll" },
        { "from": "release/build/server-install/mangosd.conf.dist", "to": "server/run/mangosd.conf.dist" },
        { "from": "release/build/server-install/realmd.conf.dist", "to": "server/run/realmd.conf.dist" },
        { "from": "release/build/server-install/msvcp140.dll", "to": "server/run/msvcp140.dll" },
        { "from": "release/build/server-install/vcruntime140.dll", "to": "server/run/vcruntime140.dll" },
        { "from": "release/build/server-install/vcruntime140_1.dll", "to": "server/run/vcruntime140_1.dll" }
      ]
    },
    {
      "name": "extractors",
      "build": "server",
      "files": [
        { "from": "release/build/server-install/Extractors/*.exe", "to": "server/run/Extractors" },
        { "from": "release/build/server-install/Extractors/*.dll", "to": "server/run/Extractors" },
        { "from": "release/build/server-install/Extractors/config.json", "to": "server/run/Extractors/config.json" },
        { "from": "release/build/server-install/Extractors/offmesh.txt", "to": "server/run/Extractors/offmesh.txt" }
      ]
    },
    {
      "name": "config",
      "build": "version",
      "files": [
        { "from": "config/*.conf", "to": "config" },
        { "from": "config/mariadb.ini" },
        { "from": "config/create-databases.sql" },
        { "from": "config/navtiles.json" },
        { "from": "config/client-patches.json" },
        { "from": "release/build/VERSION", "to": "VERSION" }
      ]
    },
    {
      "name": "base-db",
      "files": [
        { "from": "server/downloads/db/mysql-dump/logon.sql", "to": "server/sql/logon.sql" },
        { "from": "server/downloads/db/mysql-dump/characters.sql", "to": "server/sql/characters.sql" },
        { "from": "server/downloads/db/mysql-dump/logs.sql", "to": "server/sql/logs.sql" }
      ]
    },
    {
      "name": "migrations",
      "files": [
        { "from": "server/core/sql/migrations/*_characters.sql", "to": "server/sql/migrations" },
        { "from": "server/core/sql/migrations/*_logon.sql", "to": "server/sql/migrations" },
        { "from": "server/core/sql/migrations/*_logs.sql", "to": "server/sql/migrations" }
      ]
    },
    { "name": "world-db", "build": "world-dump", "files": [{ "from": "release/build/world.sql", "to": "server/sql/world.sql" }] }
  ]
}
